# Conexão PostgreSQL (use um usuário de aplicação SEM privilégio de
# UPDATE/DELETE em movement_logs — ver migration 0001_init).
DATABASE_URL="postgresql://control_app:troque_esta_senha@localhost:5432/control?schema=public"

# Segredo de verificação do JWT emitido pelo SSO.
# Gere um valor forte e único: `openssl rand -base64 48`
# NUNCA versione o valor real — este arquivo é só um modelo.
AUTH_JWT_SECRET="defina-um-segredo-forte-aqui"

# Modo de desenvolvimento — pula a verificação de JWT e usa o header
# x-dev-role como identidade. NUNCA habilitar em produção (o backend
# recusa-se a iniciar com NODE_ENV=production + DEV_NO_AUTH=true).
DEV_NO_AUTH=true

PORT=4000
NODE_ENV=development
CORS_ORIGIN="http://localhost:5173"

# URL do frontend — pra onde o backend redireciona após o login SSO.
FRONTEND_URL="http://localhost:5173"

# --- SSO OIDC (Azure AD / Microsoft Entra ID) ---
# Opcional em dev (dá pra rodar só com DEV_NO_AUTH). Se preencher UMA,
# preencha TODAS (o backend valida o conjunto e recusa config parcial).
# Os valores vêm do registro da aplicação feito pela equipe de infra (N3).
# O CLIENT_SECRET é sensível: NUNCA versione, NUNCA exponha. Se vazar,
# gere um novo no Azure e invalide o antigo.
AZURE_TENANT_ID=""
AZURE_CLIENT_ID=""
AZURE_CLIENT_SECRET=""
AZURE_REDIRECT_URI="http://localhost:4000/auth/callback"
